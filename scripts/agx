#!/usr/bin/env python3
"""agx — AGX self-awareness CLI for agents running inside the terminal.

`agx context` answers three questions in one call: who am I, what does the user
see right now, and what can I (an agent) do to this UI. It composes agtermctl's
`tree --json` + `window list --json` with the AGTERM_* env the pane inherits.

This is a prototype of a future native `agtermctl context`. No app rebuild needed.
"""
import json
import os
import shutil
import subprocess
import sys



def _find_ctl():
    """The agtermctl this agx belongs to: the app bundles agx at Contents/Resources/agx beside
    Contents/MacOS/agtermctl, so a bundled (or symlinked-from-the-bundle) agx drives ITS app even
    when the CLI was never put on PATH. A checkout copy has no sibling and falls back to PATH."""
    here = os.path.dirname(os.path.realpath(__file__))
    sibling = os.path.normpath(os.path.join(here, "..", "MacOS", "agtermctl"))
    if os.access(sibling, os.X_OK):
        return sibling
    return shutil.which("agtermctl") or "/opt/homebrew/bin/agtermctl"


CTL = _find_ctl()


def _ctl_json(*args):
    try:
        out = subprocess.run([CTL, *args, "--json"], capture_output=True, text=True, timeout=8)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    try:
        doc = json.loads(out.stdout)
    except json.JSONDecodeError:
        return None
    return doc.get("result", doc) if isinstance(doc, dict) else None


def _glyph(sess):
    st = sess.get("status")
    return {"active": "●", "completed": "✓", "blocked": "⛔"}.get(st, "")


def _running(sess):
    fg = sess.get("foreground") or []
    if not fg:
        return "shell"
    return fg[0]


def _flags(sess):
    f = []
    if sess.get("split") or sess.get("hasSplit"):
        f.append("split")
    if sess.get("overlay"):
        f.append("overlay")
    if sess.get("scratch"):
        f.append("scratch")
    if sess.get("flagged"):
        f.append("flagged")
    if sess.get("private"):
        f.append("private")
    u = sess.get("unseen")
    if u:
        f.append(f"{u} unseen")
    if sess.get("statusBlink"):
        f.append("blinking")
    if sess.get("attached"):
        f.append("reattached")
    return f


def gather():
    env = os.environ
    inside = env.get("AGTERM_ENABLED") == "1"
    tree = _ctl_json("tree") or {}
    tree = tree.get("tree", tree)  # result wraps state under "tree"
    windows = (_ctl_json("window", "list") or {}).get("windows", [])
    me_id = env.get("AGTERM_SESSION_ID")
    me = None
    active_ws = None
    active_sess = None
    for ws in tree.get("workspaces", []):
        if ws.get("active"):
            active_ws = ws
        for s in ws.get("sessions", []):
            s["_ws"] = ws.get("name")
            if s.get("id") == me_id:
                me = s
            if s.get("active"):
                active_sess = s
    return {
        "inside": inside,
        "env": {
            "session_id": me_id,
            "workspace_id": env.get("AGTERM_WORKSPACE_ID"),
            "window_id": env.get("AGTERM_WINDOW_ID"),
            "pane_id": env.get("AGTERM_PANE_ID"),
            "pane": env.get("AGTERM_PANE"),
            "socket": env.get("AGTERM_SOCKET"),
            "version": env.get("TERM_PROGRAM_VERSION"),
        },
        "me": me,
        "view": {
            "windows": windows,
            "active_workspace": active_ws,
            "focused_session": active_sess,
            "quickVisible": tree.get("quickVisible"),
            "sidebarVisible": tree.get("sidebarVisible"),
            "sidebarMode": tree.get("sidebarMode"),
            "workspaceFilter": tree.get("workspaceFilter"),
        },
        "tree": tree,
    }


MANIFEST = """you can drive this UI (agtermctl — the app's control socket, already reachable here):
  see everything again      agx context            (this call; --json for structured)
  DELEGATE to a fresh agent  agx spawn --brief "<task>" --name "<title>" [--workspace-name <W>] [--cwd <PATH>] [--agent {AGENT_CHOICES}] [--foreground] [--private]
    ^ makes the session and launches the agent with the brief as its FIRST MESSAGE (no TUI-typing race).
      A spawned pane is a FULL peer agent session (a Claude one already gets CLAUDE.md, skills, and this
      UI-context hook; other agents get `agx context` via their own hook or a line in front of the brief)
      — so the brief is a self-contained TASK, not a context dump: goal, constraints,
      where to look, what "done" means. It cannot ask you back, so leave nothing implicit. Tell it to
      write output to a file incrementally (a crash should leave half the work, not nothing).
      A bare session for an agent = an agent with no task (the empty-session bug) — always spawn+seed.
    vs. an in-turn subagent (the Agent/Task tool): invisible in this UI, shares your turn, returns to
      you — use that for token-heavy research; use `agx spawn` when the user should SEE and drive the work.
  DELEGATE LATER (tomorrow, 09:00, +2h) agx schedule add --at "<time>" --brief "<task>" --name "<title>" [--workspace-name W] [--cwd PATH]
    ^ the APP itself opens the session at that time and hands the agent the brief as its first message;
      survives app restart (fires on the next launch if it was closed, parked as "missed" after 24h).
      Same brief rules as spawn. --at: +30m | +2h | +1d | HH:MM | "tomorrow 09:00" | "YYYY-MM-DD HH:MM".
      list / cancel <id> / run <id> (fire now) — agx schedule list|cancel|run
  bare shell/session (no agent) agtermctl session new --workspace <id|name> --cwd <PATH>
  RUN shell YOUR OWN turn can't — in your session's side pane (do NOT hand terminal steps back to the user):
    finite cmd + capture   agx run "<shell cmd>"      runs it in an overlay on your pane, prints output + exit code
    persistent (tunnel/server, stays alive) agtermctl session scratch on --command "<cmd>" --target <self>
                             read it later:  agtermctl session text --pane scratch --target <self>
    ^ your session already has a real, UNrestricted shell beside you. ssh tunnels, composer, artisan serve —
      run them here yourself (it is the user's own shell; you are operating their UI), don't ask the user to.
  new workspace              agtermctl workspace new "<NAME>"
  hand YOUR task to another agent (Codex) NOW   agtermctl session failure rate_limit --handoff --target <self>
    ^ opens "<name> → <agent>" beside you, seeded with a brief from your transcript. The app already does this
      by itself when your model's usage pool is spent (/model ladder first) or the account limit hits.
  keep a session's prompts for the user   agtermctl session autoanswer off --target <id>   (on | status)
    ^ by default a permission prompt nobody answers for 45 s gets a Yes from the app (Return / Codex y);
      a prompt showing rm -rf, push --force, sudo, reset --hard, DROP … is never answered, only notified.
  message another session    agtermctl session type --target <id|prefix> --select "<text>\\n"   (\\n submits)
  read another session       agtermctl session text --target <id|prefix> [--all] [--lines N]
  a pane asks for a PASSWORD  agtermctl secret list → agtermctl secret insert <label> --target <id>   (keychain; types it, never prints it)
  focus / bring to front     agtermctl session select --target <id> | agtermctl workspace select <id>
  passive panel (HUD)        agtermctl session hud open "<message>" --target <id> [--detail ..] [--spinner] [--reveal <id>]
    ^ --reveal <session> makes the plate a link: a click closes the panel and selects that session (use it
      for a panel ABOUT another session, e.g. one you just spawned); without it the panel is inert.
  SHOW A DOCUMENT to the user agx reader <path.md>   renders the markdown in YOUR session's right pane, live-reloading
    ^ a plan, a report, a review: write the .md, open it once, keep editing the file — the pane follows.
      Do not paste long markdown into the chat when the user should read it rendered. agx reader close gives
      the pane back; the user's "Open in Reader" button moves it to a window. (agtermctl session reader --target <id>
      for someone else's session.)
  HAND OVER A RESULT FILE    agx artifact add <path|url> [--title "..."]   record a file you produced for the user
    ^ a PDF, a rendered page, an export: `open`, `agx reader` and SendUserFile are recorded by a hook already;
      call this for a file you name in chat but do not open. The user finds it later in View ▸ Artifacts (⌘⇧A)
      without re-opening this conversation. agx artifact list [--session <id>] shows what was recorded.
  ephemeral term on a session agtermctl session overlay open --target <id> -- <cmd>   (read: overlay text --target <id>)
  set my own status glyph    agtermctl session status active|completed|blocked|idle [--blink]
  close MY OWN session       agtermctl session close --target "$AGTERM_SESSION_ID"   (mine, never `active`)
    ^ when the user says "close this session / tab" they mean THIS pane, not a hand-off and not "end the
      conversation": finish the log/handoff note first, then close. Outside agx (AGTERM_ENABLED unset)
      there is nothing to close — just end the turn.
  desktop notification       agtermctl notify "<body>" [--title "..."]     native picker: agtermctl pick ...
  watch UI events (stream)   agtermctl events

you cannot (be honest about this):
  - messaging another agent is fire-and-forget stdin — you TYPE into its input; there is no
    structured request/reply yet. To get an answer back, poll `agtermctl session text` on it.
  - you cannot see GUI pixels — no window screenshot. You read terminal buffers, not the chrome.
  - editing the settings file while the app runs is silently reverted — change UI via agtermctl only.
  - a session spawned with --command execs that argv; a bare binary not on the GUI PATH exits 127."""


PRIVATE_NOTICE = ("THIS SESSION IS PRIVATE: it is never persisted and the app erases its transcript when it "
                  "closes. Do not write to amem/memory, do not call sessionize-mark, do not append to project "
                  "docs/logs or CLAUDE.md, do not leave files outside the scratchpad, do not spawn or schedule "
                  "non-private sessions carrying its content.")


def render(ctx):
    if not ctx["inside"]:
        return "Not inside AGX (AGTERM_ENABLED is unset). This shell is not in an AGX pane."
    L = []
    me = ctx["me"]
    e = ctx["env"]
    if me:
        run = _running(me)
        fl = _flags(me)
        flss = f" · {', '.join(fl)}" if fl else ""
        L.append(f'me: "{me.get("title") or me.get("name")}" [{(me.get("id") or "")[:8]}] '
                 f'· workspace {me.get("_ws")} · pane {e["pane"]} · cwd {me.get("cwd")} '
                 f'· running {run}{flss}')
        if me.get("private"):
            # the app erases this session's transcript when it closes; the agent must not copy it elsewhere.
            L.append(PRIVATE_NOTICE)
    else:
        L.append(f'me: session {(e["session_id"] or "?")[:8]} (not found in tree) · pane {e["pane"]}')
    line = f'AGX v{e["version"]}  ·  socket ok' if e["socket"] else 'AGX'
    upd = ctx["tree"].get("update") or {}
    if upd.get("available"):
        line += f'  ·  update {upd["available"]} available (agtermctl update install — agents reattach after the relaunch)'
    L.append(line)

    v = ctx["view"]
    L.append("")
    L.append("what the user sees now:")
    for w in v["windows"]:
        tags = [t for t, on in (("frontmost", w.get("active")), ("fullscreen", w.get("fullscreen")),
                                ("zoomed", w.get("zoomed")), ("minimized", w.get("minimized"))) if on]
        L.append(f'  window "{w.get("name")}" [{(w.get("id") or "")[:8]}] {", ".join(tags) or "background"}')
    aws = v["active_workspace"]
    fs = v["focused_session"]
    L.append(f'  app focus: workspace {aws.get("name") if aws else "?"}'
             + (f' → "{fs.get("title") or fs.get("name")}"' if fs else ""))
    L.append(f'  sidebar: {v["sidebarMode"]}, {"visible" if v["sidebarVisible"] else "hidden"}'
             f'  ·  quick terminal: {"open" if v["quickVisible"] else "hidden"}'
             f'  ·  workspace filter: {"on" if v["workspaceFilter"] else "off"}')

    L.append("")
    wss = ctx["tree"].get("workspaces", [])
    n_s = sum(len(w.get("sessions", [])) for w in wss)
    L.append(f'open sessions ({n_s} across {len(wss)} workspaces):')
    for w in wss:
        ss = w.get("sessions", [])
        if not ss:
            continue
        parts = []
        for s in ss:
            fl = _flags(s)
            extra = f'[{",".join(fl)}]' if fl else ""
            g = _glyph(s)
            head = (f"{g} " if g else "")
            parts.append(f'{head}{(s.get("title") or s.get("name") or "")[:34]}({_running(s)}){extra}')
        col = " · ".join(parts)
        L.append(f'  {w.get("name")}: {col}')

    L.append("")
    installed = _installed_agents() or ["claude"]
    L.append(MANIFEST.replace("{AGENT_CHOICES}", "|".join(installed)))
    return "\n".join(L)



def _ctl_raw(*args):
    try:
        out = subprocess.run([CTL, *args], capture_output=True, text=True, timeout=8)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    return out.stdout if out.returncode == 0 else ""


def _wait_ready(target, timeout=9.0, min_wait=1.2, interval=0.3):
    """Poll a session's buffer until it stabilizes — the agent CLI has booted and accepts input.

    A freshly spawned `claude` does not accept typed input the instant the pane opens; typing into
    it then is dropped (the empty-session-with-no-brief failure). Waiting for two identical
    non-empty reads, with a floor, means the seed lands in a ready prompt, not a race."""
    import time
    start = time.time(); prev = None; stable = 0
    while time.time() - start < timeout:
        txt = _ctl_raw("session", "text", "--target", target)
        if txt and txt == prev:
            stable += 1
            if stable >= 2 and (time.time() - start) >= min_wait:
                return True
        else:
            stable = 0
        prev = txt
        time.sleep(interval)
    return True



def _claude_trusts(path):
    """True if Claude Code has already accepted the trust dialog for `path` (~/.claude.json). When it has
    NOT, a session opened there stops on the one-time trust gate before the seeded brief can run — so
    spawn warns instead of hanging silently. Unknown/unreadable config → None (say nothing)."""
    if not path:
        return None
    try:
        real = os.path.realpath(os.path.expanduser(path))
        cfg = json.load(open(os.path.expanduser("~/.claude.json")))
    except (OSError, ValueError):
        return None
    entry = (cfg.get("projects") or {}).get(real)
    if not isinstance(entry, dict):
        return False
    return bool(entry.get("hasTrustDialogAccepted"))


def _codex_trusts(path):
    """Codex counterpart of `_claude_trusts`: True if `~/.codex/config.toml` has
    `[projects."<realpath>"] trust_level = "trusted"`. Codex shows its own one-time trust gate per
    directory (plus a hooks-review gate the first time agterm's status hooks appear), and a seeded
    brief waits behind it exactly like Claude's. Unknown/unreadable config → None."""
    if not path:
        return None
    try:
        real = os.path.realpath(os.path.expanduser(path))
        text = open(os.path.expanduser("~/.codex/config.toml")).read()
    except OSError:
        return None
    import re
    m = re.search(r'^\[projects\.' + re.escape(json.dumps(real)) + r'\]\s*\n((?:(?!\[).*\n?)*)', text, re.M)
    if not m:
        return False
    return re.search(r'^\s*trust_level\s*=\s*"trusted"', m.group(1), re.M) is not None


def _gemini_trusts(path):
    """Gemini CLI's folder trust: `~/.gemini/trustedFolders.json` maps a path to TRUST_FOLDER /
    TRUST_PARENT / DO_NOT_TRUST. An untrusted folder is a hard stop for a seeded `-i` launch."""
    if not path:
        return None
    try:
        real = os.path.realpath(os.path.expanduser(path))
        cfg = json.load(open(os.path.expanduser(os.environ.get("GEMINI_CLI_TRUSTED_FOLDERS_PATH")
                                                or "~/.gemini/trustedFolders.json")))
    except (OSError, ValueError):
        return None
    if not isinstance(cfg, dict):
        return None
    for folder, rule in cfg.items():
        f = os.path.realpath(os.path.expanduser(folder))
        if rule == "TRUST_FOLDER" and real == f:
            return True
        if rule == "TRUST_PARENT" and (real == f or real.startswith(f.rstrip("/") + "/")):
            return True
    return False


def _mimo_trusts(path):
    """Mimo's workspace trust: `~/.local/share/mimocode/trusted-workspaces.json` → {"trustedPaths": [...]}."""
    if not path:
        return None
    try:
        real = os.path.realpath(os.path.expanduser(path))
        cfg = json.load(open(os.path.expanduser("~/.local/share/mimocode/trusted-workspaces.json")))
    except (OSError, ValueError):
        return None
    paths = cfg.get("trustedPaths") if isinstance(cfg, dict) else None
    if not isinstance(paths, list):
        return None
    return any(os.path.realpath(os.path.expanduser(p)) == real for p in paths if isinstance(p, str))


TRUST_PROBES = {
    "claudeProjects": _claude_trusts,
    "codexProjects": _codex_trusts,
    "geminiTrustedFolders": _gemini_trusts,
    "mimoTrustedWorkspaces": _mimo_trusts,
}

CONTEXT_PREFIX = ("You are running inside AGX, an agent terminal. Run `agx context` first: it tells you "
                  "which pane you are, what the user sees, and what you can do to this UI.\n\n")


def _agents_dir():
    """The `agents/<binary>/agent.json` manifests — the same files the app reads (AgentCatalog.swift):
    the bundled package beside this script, else the installed copy, else the source checkout."""
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (os.environ.get("AGTERM_AGENTS_DIR"),
              os.path.join(here, "agent-status", "agents"),
              os.path.expanduser("~/.config/agx/agent-status/agents"),
              os.path.normpath(os.path.join(here, "..", "agterm", "Resources", "agent-status", "agents"))):
        if d and os.path.isdir(d):
            return d
    return None


def _load_agents():
    """{binary: manifest} in catalog order; a malformed manifest is skipped, no directory → {}."""
    d = _agents_dir()
    if not d:
        return {}
    agents = []
    for name in os.listdir(d):
        try:
            m = json.load(open(os.path.join(d, name, "agent.json")))
        except (OSError, ValueError):
            continue
        if isinstance(m, dict) and isinstance(m.get("binary"), str) and isinstance(m.get("name"), str):
            agents.append(m)
    agents.sort(key=lambda m: (m.get("order", 1 << 30), m["binary"]))
    return {m["binary"]: m for m in agents}


AGENTS = _load_agents()


def _agent_exe(agent):
    return os.path.basename((agent or "").strip().split(" ", 1)[0])


def _agent_profile(agent):
    """The manifest behind a launch line (`claude`, `codex --model x`); an unknown binary gets the
    launch-only floor: positional brief, no context hook, no trust probe."""
    return AGENTS.get(_agent_exe(agent), {})


def _installed_agents():
    """Known agent binaries on PATH plus the per-user tool dirs a GUI-spawned shell may lack."""
    extra = [os.path.expanduser(d) for d in ("~/.local/bin", "~/.bun/bin", "~/.cargo/bin", "~/.npm-global/bin")]
    path = os.environ.get("PATH", "") + ":" + ":".join(extra) + ":/opt/homebrew/bin:/usr/local/bin"
    return [b for b in AGENTS if shutil.which(b, path=path)]


def _agent_trusts(agent, path):
    """Dispatch the trust probe on the agent's executable (`claude`, `codex --model x`, …). Agents we
    don't know how to probe → None (no warning either way)."""
    trust = _agent_profile(agent).get("trust") or {}
    probe = TRUST_PROBES.get(trust.get("kind"))
    if probe:
        return probe(path)
    return None


CODEX_SPAWN_FLAGS = "-a on-request -s workspace-write"


def _agent_launch(agent):
    """The exec line for `--agent`. A bare `codex` gets the flags a peer session needs to get on with a
    brief unattended: approval only when the model asks for it (`-a on-request`; codex-cli 0.154 dropped
    `on-failure`) and a sandbox that can write the workspace (`-s workspace-write`). Those prompts are
    what auto-answer then handles. An agent line that already spells its own flags is left alone."""
    parts = agent.split()
    if parts and os.path.basename(parts[0]) == "codex" and not any(
            t in ("-a", "--ask-for-approval", "-s", "--sandbox", "--full-auto", "--yolo",
                  "--dangerously-bypass-approvals-and-sandbox") for t in parts[1:]):
        return agent + " " + CODEX_SPAWN_FLAGS
    return agent


def cmd_spawn(argv):
    """Create an agent session AND seed it with a brief — the smart 'delegate to a fresh agent'.

    A bare `session new --command claude` lands an agent with no task; the point of spawning one is
    almost always to hand it work. This does the compound act atomically: create, wait until the
    agent is ready, inject the brief (newline submits)."""
    opts = {"brief": None, "name": None, "cwd": None, "workspace": None,
            "workspace_name": None, "agent": "claude", "foreground": False, "json": False, "private": False}
    a = argv[2:]; i = 0
    flags = {"--brief": "brief", "--name": "name", "--cwd": "cwd",
             "--workspace": "workspace", "--workspace-name": "workspace_name", "--agent": "agent"}
    while i < len(a):
        t = a[i]
        if t in flags:
            if i + 1 >= len(a):
                print(f"agx spawn: {t} needs a value", file=sys.stderr); return 2
            opts[flags[t]] = a[i + 1]; i += 2
        elif t == "--foreground":
            opts["foreground"] = True; i += 1
        elif t == "--private":
            opts["private"] = True; i += 1
        elif t == "--json":
            opts["json"] = True; i += 1
        else:
            print(f"agx spawn: unknown arg {t}", file=sys.stderr); return 2
    if not opts["brief"]:
        print("agx spawn: --brief is required (the task text to seed the new agent with)", file=sys.stderr)
        return 2
    # Seed via the agent's FIRST-MESSAGE argument, not by typing into the TUI: a freshly spawned
    # agent drops input typed before it is ready (the empty-session race). Passing the brief on the
    # command line means the agent starts already carrying it — reliable even for a background pane.
    import tempfile
    fd, briefpath = tempfile.mkstemp(dir="/tmp", prefix="agx-brief-")
    with os.fdopen(fd, "w") as f:
        f.write(opts["brief"])
    # brief lives in the file, never inline, so its quotes/newlines/$ can't break the command string.
    # Where "$b" goes is the agent's profile (`gemini -i "$b"`, `opencode --prompt "$b"`); an agent with
    # no SessionStart context hook gets a one-line pointer to `agx context` in front of the brief.
    profile = _agent_profile(opts["agent"])
    if profile.get("context") != "sessionStartHook":
        with open(briefpath, "w") as f:
            f.write(CONTEXT_PREFIX + opts["brief"])
    seed = " ".join(([profile["seedFlag"]] if profile.get("seedFlag") else []) + ['"$b"'])
    body = 'b="$(cat %s)"; rm -f %s; exec %s %s' % (briefpath, briefpath, opts["agent"], seed)
    command = "zsh -lc '" + body + "'"
    args = ["session", "new", "--command", command]
    if not opts["foreground"]:
        args.append("--no-select")
    if opts["private"]:
        args.append("--private")
    if opts["cwd"]:
        args += ["--cwd", opts["cwd"]]
    if opts["name"]:
        args += ["--name", opts["name"]]
    if opts["workspace"]:
        args += ["--workspace", opts["workspace"]]
    elif opts["workspace_name"]:
        args += ["--workspace-name", opts["workspace_name"], "--create-workspace"]
    elif os.environ.get("AGTERM_WORKSPACE_ID"):
        # default to the CALLER's workspace, not the app-focused one (`session new` defaults to app focus,
        # which may be a different window) — spawning a peer should land beside the agent that asked for it.
        args += ["--workspace", os.environ["AGTERM_WORKSPACE_ID"]]
    res = _ctl_json(*args)
    sid = res.get("id") if isinstance(res, dict) else None
    if not sid:
        try: os.remove(briefpath)
        except OSError: pass
        print("agx spawn: session creation failed", file=sys.stderr); return 1
    trusted = _agent_trusts(opts["agent"], opts["cwd"])
    if opts["json"]:
        print(json.dumps({"id": sid, "seeded": True, "foreground": opts["foreground"],
                          "private": opts["private"], "cwd_trusted": trusted}, ensure_ascii=False))
    else:
        where = opts["workspace"] or opts["workspace_name"] or os.environ.get("AGTERM_WORKSPACE_ID", "current workspace")
        tail = f' — "{opts["name"]}"' if opts["name"] else ""
        print(f'agx: spawned {opts["agent"]} [{sid[:8]}] in {where}{tail}, launched with the brief as its first message.')
        if trusted is False:
            print(f'  ⚠ {opts["cwd"]} is not trusted by {opts["agent"]} yet — accept the one-time trust prompt in the '
                  'new pane; the brief runs right after.')
    return 0



def cmd_usage(argv):
    """Cross-session usage — the accurate, aggregate view the per-session CC statusline can't give.

    Joins the live `tree` (source of truth for what is actually open) with the metrics each session's
    statusline emits to ~/.claude/agx-usage/. Counts only real open agent sessions (fixes the
    file-mtime overcount) and shows the account pools (5h/7d) once, correctly labeled."""
    import glob, time
    as_json = "--json" in argv
    tree = _ctl_json("tree") or {}
    tree = tree.get("tree", tree)
    udir = os.path.expanduser("~/.claude/agx-usage")
    emits = {}
    for fp in glob.glob(os.path.join(udir, "*.json")):
        try:
            d = json.load(open(fp))
        except (OSError, ValueError):
            continue
        if d.get("sid"):
            emits[d["sid"]] = d
    sessions = []
    pool5 = pool7 = None; pool_ts = -1
    now = time.time()
    for ws in tree.get("workspaces", []):
        for s in ws.get("sessions", []):
            e = emits.get(s.get("id"))
            if e and e.get("ts", 0) > pool_ts:
                pool_ts = e["ts"]; pool5 = e.get("five_hour"); pool7 = e.get("seven_day")
            sessions.append({
                "id": s.get("id"), "name": s.get("title") or s.get("name"), "ws": ws.get("name"),
                "agent": (s.get("foreground") or [None])[0],
                "model": (e or {}).get("model"), "ctx_pct": (e or {}).get("ctx_pct"),
                "ctx_size": (e or {}).get("ctx_size"), "cost": (e or {}).get("cost"),
                "fresh": bool(e) and (now - e.get("ts", 0) < 900),
            })
    agents = [s for s in sessions if s["agent"]]
    total = sum(s["cost"] or 0 for s in sessions if s["fresh"])
    if as_json:
        print(json.dumps({"pool_five_hour": pool5, "pool_seven_day": pool7,
                          "total_cost_fresh": total, "sessions": sessions}, ensure_ascii=False, indent=2))
        return 0
    p5 = f"{pool5}%" if pool5 is not None and pool5 >= 0 else "?"
    p7 = f"{pool7}%" if pool7 is not None and pool7 >= 0 else "?"
    L = [f"AGX usage — {len(agents)} agent sessions  ·  account: 5h {p5}  7d {p7}"]
    for s in agents:
        if s["model"] and s["fresh"]:
            k = int((s["ctx_size"] or 0) * (s["ctx_pct"] or 0) / 100 / 1000)
            mark = " ⚠2x" if k >= 200 else ""
            data = f'{s["model"]}  {s["ctx_pct"]}% ({k}k){mark}  ${s["cost"]:.2f}'
        else:
            data = "— (no live statusline emit yet — open/refresh the session once)"
        L.append(f'  {(s["name"] or "")[:34]:34} [{(s["id"] or "")[:8]}] {data}')
    L.append(f"  total (fresh sessions): ${total:.2f}")
    print("\n".join(L))
    return 0



def cmd_run(argv):
    """Run a FINITE shell command in THIS session's own side pane and return its output + exit code.

    The agent's own turn may be blocked by the command classifier (ssh, composer, package managers), but
    the session has a real shell beside it. This runs the command in an overlay on the current pane — the
    user's own unrestricted shell, the agent operating the UI on their behalf — waits for it to finish, and
    hands back what it printed. For a PERSISTENT process (a tunnel, `artisan serve`) use the scratch shell
    instead (it stays alive): `agtermctl session scratch on --command "<cmd>"`."""
    a = argv[2:]
    pane = None; keep = False; parts = []
    i = 0
    while i < len(a):
        if a[i] == "--pane":
            if i + 1 >= len(a): print("agx run: --pane needs a value", file=sys.stderr); return 2
            pane = a[i + 1]; i += 2
        elif a[i] == "--keep":
            keep = True; i += 1
        else:
            parts.append(a[i]); i += 1
    cmd = parts[0] if len(parts) == 1 else " ".join(parts)
    if not cmd.strip():
        print('agx run: need a command, e.g. agx run "composer install"', file=sys.stderr); return 2
    import tempfile
    fd, cmdfile = tempfile.mkstemp(dir="/tmp", prefix="agx-cmd-"); os.close(fd)
    with open(cmdfile, "w") as f:
        f.write(cmd + "\n")
    outfile = cmdfile.replace("agx-cmd-", "agx-out-")
    # command text lives in cmdfile (no inline quoting), the wrapper only names controlled /tmp paths.
    overlay_cmd = "zsh -lc 'zsh %s > %s 2>&1'" % (cmdfile, outfile)
    ctl_args = [CTL, "session", "overlay", "open", overlay_cmd, "--block"]
    self_id = os.environ.get("AGTERM_SESSION_ID")
    if self_id:
        ctl_args += ["--target", self_id]
    if pane:
        ctl_args += ["--pane", pane]
    try:
        proc = subprocess.run(ctl_args, capture_output=True, text=True, timeout=1800)
    except subprocess.TimeoutExpired:
        print("agx run: command still running after 30m — use a scratch shell for long-running processes",
              file=sys.stderr); return 1
    rc = proc.returncode
    out = ""
    try:
        with open(outfile) as f:
            out = f.read()
    except OSError:
        pass
    sys.stdout.write(out)
    if not out.endswith("\n"):
        sys.stdout.write("\n")
    print(f"[agx run: exit {rc}]")
    if not keep:
        for fp in (cmdfile, outfile):
            try: os.remove(fp)
            except OSError: pass
    return rc


def cmd_reader(argv):
    """Show a markdown file, rendered and live-reloading, in THIS session's right split pane (or --target's);
    `agx reader close` gives the pane back. Sugar over `agtermctl session reader`: an in-pane agent's own session is the default
    target, since the document is for the user watching this pane."""
    a = list(argv[2:])
    target = os.environ.get("AGTERM_SESSION_ID")
    passthrough = []
    i = 0
    while i < len(a):
        if a[i] == "--target":
            if i + 1 >= len(a): print("agx reader: --target needs a value", file=sys.stderr); return 2
            target = a[i + 1]; i += 2
        else:
            passthrough.append(a[i]); i += 1
    if not passthrough:
        print("agx reader: need a path, e.g. agx reader docs/plan.md   (or: agx reader close)", file=sys.stderr); return 2
    verb = ["close"] if passthrough == ["close"] else ["open", *passthrough]
    ctl_args = [CTL, "session", "reader", *verb]
    if target:
        ctl_args += ["--target", target]
    return subprocess.call(ctl_args)


def cmd_artifact(argv):
    """`agx artifact add|list|...` — sugar over `agtermctl artifact`: `add` defaults the showing session
    to this pane (agtermctl reads AGTERM_SESSION_ID itself) and the transcript to the CLAUDE_CODE_SESSION_ID
    the agent inherits, so a manual add carries the way back to the conversation. `backfill` is local."""
    a = list(argv[2:])
    if a[:1] == ["backfill"]:
        return cmd_artifact_backfill(a[1:])
    if a[:1] == ["add"] and "--agent-session" not in a and os.environ.get("CLAUDE_CODE_SESSION_ID"):
        a += ["--agent-session", os.environ["CLAUDE_CODE_SESSION_ID"]]
    return subprocess.call([CTL, "artifact", *a])


# --- artifact backfill: the hook's rule replayed over past Claude Code transcripts -------------------

_SHELL_BREAKS = ("&&", "||", ";", ";;", "|", "&")
_OPEN_VALUE_FLAGS = ("-a", "-b", "-s", "--env", "--stdin", "--stdout", "--stderr")
_OPEN_BARE_FLAGS = ("-e", "-t", "-h")


def _shown_refs(tool, inp, cwd):
    """The files/URLs one tool call SHOWED the user, as (source, base, ref, title) — the same rule as
    agx-artifacts.sh: Bash `open` args (flag values and redirections excluded, `cd` prefixes honoured),
    `agx reader <md>`, and SendUserFile's files. Writes are never artifacts."""
    import shlex
    out = []

    def emit(source, base, ref, title=""):
        ref = str(ref).strip()
        if not ref or ref in (".", "..") or ref.startswith("-"):
            return
        out.append((source, base, ref, " ".join(str(title).split())[:200]))

    if tool == "SendUserFile":
        for f in inp.get("files") or []:
            emit("sendfile", cwd, f, inp.get("caption") or "")
        return out
    if tool != "Bash":
        return out
    text = inp.get("command") or ""
    if "open" not in text and "reader" not in text:
        return out
    try:
        lexer = shlex.shlex(text, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        words = list(lexer)
    except ValueError:
        return out
    base = cwd
    segments, current = [], []
    for w in words:
        if w in _SHELL_BREAKS:
            segments.append(current); current = []
        else:
            current.append(w)
    segments.append(current)
    for seg in segments:
        while seg and (seg[0] == "env" or ("=" in seg[0] and not seg[0].startswith(("/", ".", "~")))):
            seg = seg[1:]
        if not seg:
            continue
        verb, rest = seg[0], seg[1:]
        if verb == "cd" and rest:
            target = os.path.expanduser(rest[0])
            base = target if target.startswith("/") else os.path.join(base, target)
        elif verb == "open":
            skip = False
            for a in rest:
                if a in ("<", ">", ">>", "2>", "&>"):
                    break
                if skip:
                    skip = False; continue
                if a in _OPEN_VALUE_FLAGS:
                    skip = True; continue
                if a == "--args":
                    break
                if a in _OPEN_BARE_FLAGS or a.startswith("-"):
                    continue
                emit("open", base, a)
        elif verb == "agx" and rest[:1] == ["reader"]:
            args, title, i = rest[1:], "", 0
            while i < len(args):
                a = args[i]
                if a == "--title" and i + 1 < len(args):
                    title = args[i + 1]; i += 2; continue
                if a.startswith("-") or a == "close":
                    i += 1; continue
                emit("reader", base, a, title); i += 1
    return out


def _agx_sessions_by_transcript():
    """transcript uuid → (agx session id) from the window snapshots and the recent-closed list: the
    SessionStart hook pins `claude --resume <uuid>` as each pane's restore command, so the uuid a pane
    currently resumes is the transcript it is running."""
    import glob, re
    root = os.environ.get("AGTERM_STATE_DIR") or os.path.expanduser("~/Library/Application Support/agx")
    found = {}
    pat = re.compile(r"claude --resume ([0-9a-f-]{36})")

    def note(snapshot):
        m = pat.search(snapshot.get("restoreCommand") or "")
        if m and snapshot.get("id"):
            found.setdefault(m.group(1), snapshot["id"])

    for f in glob.glob(root + "/windows/*.json"):
        try:
            d = json.load(open(f))
        except (OSError, ValueError):
            continue
        for w in d.get("workspaces", []):
            for sess in w.get("sessions", []):
                note(sess)
    try:
        closed = json.load(open(root + "/recent-closed.json"))
        entries = closed if isinstance(closed, list) else next((v for v in closed.values() if isinstance(v, list)), [])
        for e in entries:
            snap = ((e.get("session") or {}).get("snapshot")) or {}
            note(snap)
    except (OSError, ValueError, AttributeError):
        pass
    return found


def cmd_artifact_backfill(args):
    """agx artifact backfill [--days N | --all] [--dry-run] [--socket S]: replay the hook's rule over
    the Claude Code transcripts in ~/.claude/projects and `artifact add --source backfill` every file
    that was shown and still exists (URLs always). One add per path with its latest showing; a row the
    live hook already holds is left alone by the index (an older backfill never overrides it)."""
    import glob, time
    from datetime import datetime, timezone
    days, dry, socket = 30, False, None
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--days" and i + 1 < len(args):
            days = int(args[i + 1]); i += 2; continue
        if a == "--all":
            days = None
        elif a == "--dry-run":
            dry = True
        elif a == "--socket" and i + 1 < len(args):
            socket = args[i + 1]; i += 1
        else:
            print(f"agx artifact backfill: unknown argument {a}", file=sys.stderr); return 2
        i += 1
    since = None if days is None else time.time() - days * 86400
    sessions = _agx_sessions_by_transcript()
    latest = {}  # ref key → (seen iso, source, base, ref, title, transcript uuid, cwd)
    scanned = 0
    for path in glob.glob(os.path.expanduser("~/.claude/projects/*/*.jsonl")):
        try:
            if since is not None and os.path.getmtime(path) < since:
                continue
        except OSError:
            continue
        uuid = os.path.splitext(os.path.basename(path))[0]
        scanned += 1
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if '"tool_use"' not in line or ('"Bash"' not in line and '"SendUserFile"' not in line):
                        continue
                    try:
                        rec = json.loads(line)
                    except ValueError:
                        continue
                    if rec.get("type") != "assistant":
                        continue
                    ts = rec.get("timestamp") or ""
                    if since is not None and ts:
                        try:
                            if datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp() < since:
                                continue
                        except ValueError:
                            pass
                    cwd = rec.get("cwd") or os.path.expanduser("~")
                    for block in (rec.get("message") or {}).get("content") or []:
                        if not isinstance(block, dict) or block.get("type") != "tool_use":
                            continue
                        for source, base, ref, title in _shown_refs(block.get("name"), block.get("input") or {}, cwd):
                            key = ref if ref.startswith(("http://", "https://")) else os.path.normpath(
                                os.path.expanduser(ref if ref.startswith(("/", "~")) else os.path.join(base, ref)))
                            if not key.startswith("http") and (not os.path.isfile(key)):
                                continue
                            if key not in latest or latest[key][0] < ts:
                                latest[key] = (ts, source, base, ref, title, uuid, cwd)
        except OSError:
            continue
    rows = sorted(latest.values())
    print(f"scanned {scanned} transcripts, {len(rows)} artifacts to record ({len(sessions)} transcripts map to a session)")
    added = 0
    for ts, source, base, ref, title, uuid, cwd in rows:
        sid = sessions.get(uuid)
        cmd = [CTL, "artifact", "add", ref, "--source", "backfill", "--cwd", base, "--session", sid or "none",
               "--agent-session", uuid]
        if ts:
            cmd += ["--seen", ts]
        if title:
            cmd += ["--title", title]
        if socket:
            cmd += ["--socket", socket]
        if dry:
            print(f"{ts}  {source:8} {ref}  ← {sid or '-'}")
            continue
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode == 0:
            added += 1
        else:
            print(f"skip {ref}: {r.stderr.strip() or r.stdout.strip()}", file=sys.stderr)
    if not dry:
        print(f"recorded {added}")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "context"
    if cmd in ("-h", "--help", "help"):
        print("usage:\n"
              "  agx context [--json]           self-description of the AGX UI for an in-pane agent\n"
              "  agx usage [--json]             accurate cross-session model/context/cost + account pools\n"
              "  agx run \"<shell cmd>\" [--pane split]  run a FINITE command in THIS session's side pane, return output+exit\n"
              "  agx reader <path.md> [--target ID]   show a markdown file, live-reloading, in THIS session's right pane\n"
              "  agx reader close [--target ID]      give the pane back\n"
              "  agx artifact add <path|url> [--title T]   record a result file for the user's Artifacts window\n"
              "  agx artifact list|open|pin|hide|remove|show   (agtermctl artifact ...)\n"
              "  agx artifact backfill [--days N|--all] [--dry-run]   replay past transcripts into the index\n"
              "  agx spawn --brief \"<task>\" [--name T] [--workspace-name W|--workspace ID]\n"
              "            [--cwd PATH] [--agent claude|codex] [--foreground] [--private] [--json]\n"
              "            create an agent session AND seed it with the brief as its first message\n"
              "  agx schedule add --at <time> --brief \"<task>\" [--name T] [--workspace-name W|--workspace ID] [--cwd PATH]\n"
              "  agx schedule list | cancel <id> | run <id>\n"
              "            the APP opens the session at <time> with the brief as its first message (survives restart)")
        return 0
    if cmd == "spawn":
        return cmd_spawn(argv)
    if cmd == "schedule":
        return subprocess.call([CTL, "schedule", *argv[2:]])
    if cmd == "usage":
        return cmd_usage(argv)
    if cmd == "run":
        return cmd_run(argv)
    if cmd == "reader":
        return cmd_reader(argv)
    if cmd == "artifact":
        return cmd_artifact(argv)
    if cmd != "context":
        print(f"agx: unknown command '{cmd}'", file=sys.stderr)
        return 2
    ctx = gather()
    if "--json" in argv:
        print(json.dumps(ctx, ensure_ascii=False, indent=2))
    else:
        print(render(ctx))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
